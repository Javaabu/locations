{
  "name": "javaabu/locations",
  "description": "Countries, states, cities, atolls and islands for Laravel: seedable data for every country (ISO 3166) and every Maldivian atoll and island (official codes, Dhivehi names), admin pages in Blade (javaabu/forms) or Inertia React (@javaabu/forms), and cascading location selects for javaabu/forms, @javaabu/forms and javaabu/stencil.",
  "homepage": "https://github.com/Javaabu/locations",
  "license": "MIT",
  "keywords": [
    "javaabu",
    "laravel",
    "locations",
    "countries",
    "maldives",
    "atolls",
    "islands",
    "iso-3166",
    "dhivehi"
  ],
  "authors": [
    {
      "name": "Javaabu Pvt. Ltd.",
      "email": "info@javaabu.com",
      "homepage": "https://javaabu.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/routing": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/validation": "^12.0 || ^13.0",
    "illuminate/view": "^12.0 || ^13.0",
    "javaabu/forms": "^2.0@dev",
    "javaabu/manifest": "^1.0@dev",
    "javaabu/permissions": "^3.0@dev",
    "javaabu/stencil": "^1.0@dev"
  },
  "require-dev": {
    "inertiajs/inertia-laravel": "^2.0 || ^3.0",
    "javaabu/boost-javaabu-guidelines": "^1.4",
    "javaabu/translatable": "^3.0@dev",
    "laravel/pint": "^1.24",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5.3 || ^12.5.8"
  },
  "suggest": {
    "inertiajs/inertia-laravel": "Render the admin pages with Inertia React (^2.0 || ^3.0)",
    "javaabu/translatable": "Translate location names into every active language (^3.0)"
  },
  "autoload": {
    "psr-4": {
      "Javaabu\\Locations\\": "src/",
      "Javaabu\\Locations\\Database\\Seeders\\": "database/seeders/",
      "Javaabu\\Locations\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Javaabu\\Locations\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
    "lint": "vendor/bin/pint --test",
    "format": "vendor/bin/pint"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    },
    "laravel": {
      "providers": [
        "Javaabu\\Locations\\LocationsServiceProvider"
      ]
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Javaabu/forms"
    },
    {
      "type": "vcs",
      "url": "https://github.com/Javaabu/manifest"
    },
    {
      "type": "vcs",
      "url": "https://github.com/Javaabu/permissions"
    },
    {
      "type": "vcs",
      "url": "https://github.com/Javaabu/stencil"
    },
    {
      "type": "vcs",
      "url": "https://github.com/n4ff4h/translatable"
    }
  ],
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
